    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.8",
    "prisma": "^6.12.0",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "prisma@6.12.0": true,
