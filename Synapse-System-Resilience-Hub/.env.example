# PostgreSQL
DATABASE_URL="postgresql://synopse:change-me@localhost:5432/synopse?schema=public"

# Protect the inbound email webhook. Generate a long random value for each environment.
INBOUND_EMAIL_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Required in production. Use a unique, long password; serve the app over HTTPS.
SYNOPSE_ACCESS_USER="operations"
SYNOPSE_ACCESS_PASSWORD="replace-with-a-long-random-password"

# MFA delivery (server-side only). Configure the provider for each enabled channel.
RESEND_API_KEY=""
MFA_EMAIL_FROM="Synopse <login@your-verified-domain.com>"
ALERT_EMAIL_FROM="Synopse <alerts@your-verified-domain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Protect the hourly alert generator cron request.
CRON_SECRET="replace-with-a-long-random-secret"

# ServiceNow incident sync (server-side only)
SERVICENOW_INSTANCE_URL="https://your-instance.service-now.com"
SERVICENOW_ACCESS_TOKEN=""
SERVICENOW_USERNAME=""
SERVICENOW_PASSWORD=""

# LLM provider keys (server-side only)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# SharePoint Microsoft Graph app credentials (server-side only)
SHAREPOINT_TENANT_ID=""
SHAREPOINT_CLIENT_ID=""
SHAREPOINT_CLIENT_SECRET=""
SHAREPOINT_SITE_ID=""

# Jira Cloud
JIRA_BASE_URL="https://your-company.atlassian.net"
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Confluence Cloud (base URL, e.g. https://your-company.atlassian.net)
CONFLUENCE_BASE_URL="https://your-company.atlassian.net"
CONFLUENCE_EMAIL=""
CONFLUENCE_API_TOKEN=""

# GitHub Actions deployment uses Vercel CLI; configure these as repository/environment secrets.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
